[{"id": "2114455660851065314", "text": "The moment Espart got INJURED \ud83e\udd72\ud83d\udc94", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114455506836439040/vid/avc1/1280x720/8lX1kUD21WMqP2ID.mp4?tag=29"}, {"id": "2114456036685877491", "text": "33' Mbappe with a great chance but his volley goes into the skies.", "media_type": null, "media_url": null}, {"id": "2114456211819040936", "text": "33' GORDON WITH A CHANCE BUT LUNIN DENIES.", "media_type": null, "media_url": null}, {"id": "2114457981181977072", "text": "40' Goal Real Madrid. Gerard Mart\u00edn's clearance hits Mbappe and the ball goes in. 0-1.", "media_type": null, "media_url": null}, {"id": "2114458558439759963", "text": "43' BIG CHANCE FOR LAMINE BUT HE DOESN'T GET IT ON TARGET.", "media_type": null, "media_url": null}, {"id": "2114459601370272018", "text": "Half-time: Barcelona \ud835\udfce-\ud835\udfcf Real Madrid", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgRzUiXkAA6dFA.jpg"}, {"id": "2114461731233615937", "text": "What should Bar\u00e7a change in the second half? \ud83e\udd14", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgTvSXXEAAalvn.jpg"}, {"id": "2114461888973013083", "text": "\ud83d\udea8| \ud835\udc0e\ud835\udc05\ud835\udc05\ud835\udc08\ud835\udc02\ud835\udc08\ud835\udc00\ud835\udc0b: 62,055 fans at Spotify Camp Nou. #fcblive \ud83d\udc99\u2764\ufe0f", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgT4euXoAAcOfg.jpg"}, {"id": "2114463195863597181", "text": "Ferm\u00edn \ud83e\udd2f", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114463043598065664/vid/avc1/720x1278/ffqekjSwUWI2TaPG.mp4?tag=29"}, {"id": "2114464306393760179", "text": "45' The second half.", "media_type": null, "media_url": null}, {"id": "2114464451684376705", "text": "46' Yellow for Tchouameni. \ud83d\udfe1", "media_type": null, "media_url": null}, {"id": "2114465522305966555", "text": "This is NOT normal \ud83d\ude2c", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114465301538713600/vid/avc1/558x314/2-TcvzgUTzMn4J8W.mp4?tag=29"}, {"id": "2114465599434686773", "text": "50' Gerard Martin prevents a goal.", "media_type": null, "media_url": null}, {"id": "2114466266841030787", "text": "MARTIN \ud83d\udcaa\ud83c\udffc\ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114466092878090240/vid/avc1/1280x720/pElOvsL1XMo5odSp.mp4?tag=29"}, {"id": "2114466267562205198", "text": "52' Pedri with a great chance to shoot but Bellingham robs the ball off him.", "media_type": null, "media_url": null}, {"id": "2114466654327312760", "text": "54' Raphinha with a run towards the goal, great chance but he loses the ball in the end.", "media_type": null, "media_url": null}, {"id": "2114468177467871722", "text": "GOALLLLLLL RAPHINHAAAAAAAAA. PEDRI ASSIST. 1-1 BAR\u00c7AAAAAAAA \ud83d\udd35\ud83d\udd34\ud83d\udd25", "media_type": null, "media_url": null}, {"id": "2114468378920284322", "text": "\ud83c\udfa5 | RAPHINHA EQUALIZES FOR BAR\u00c7A. IT'S 1-1. #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114468062069985280/vid/avc1/1280x720/sf358npCo8dOA8zZ.mp4?tag=14"}, {"id": "2114469343144685751", "text": "65' LUNIN WITH AN UNBELIEVABLE SAVE TO DENY MARTIN'S HEADER.", "media_type": null, "media_url": null}, {"id": "2114469562875863342", "text": "Unreal save by Lunin.", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114469178983714816/vid/avc1/1280x720/Xpr93hycfiwz3XGh.mp4?tag=14"}, {"id": "2114469746619941060", "text": "Mr. Clutch \ud83c\udde7\ud83c\uddf7\ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgbB3bWkAEseIt.jpg"}, {"id": "2114471381718945801", "text": "73' FRENKIE DE JONG IS COMING ON FOR FERM\u00cdN.", "media_type": null, "media_url": null}, {"id": "2114472496795709838", "text": "77' LAMINE YAMAL ALMOST FINDS THE BOTTOM CORNER. So close!", "media_type": null, "media_url": null}, {"id": "2114474106116575544", "text": "84' Gordon CLEARLY GETS THE BALL but he's given a yellow. \ud83d\udfe1", "media_type": null, "media_url": null}, {"id": "2114474356956962890", "text": "85' SUBSTITUTIONS:\n\n\ud83d\udd34 Raphinha, Gordon\n\ud83d\udfe2 Jesus, Adeyemi", "media_type": null, "media_url": null}, {"id": "2114474832544862688", "text": "87' Goal Real Madrid. Kylian Mbappe. 1-2.", "media_type": null, "media_url": null}, {"id": "2114477386993389578", "text": "\ud83d\udea8 FULL-TIME: Barcelona \ud835\udfcf-\ud835\udfd0 Real Madrid\n\nDefeat at the Spotify Camp Nou. #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgh-kWXUAE7uvg.jpg"}, {"id": "2114478855603830911", "text": "\ud83d\udea8 \ud835\udc14\ud835\udc0f\ud835\udc03\ud835\udc00\ud835\udc13\ud835\udc04\ud835\udc03 \ud835\udc0b\ud835\udc00 \ud835\udc0b\ud835\udc08\ud835\udc06\ud835\udc00 \ud835\udc13\ud835\udc00\ud835\udc01\ud835\udc0b\ud835\udc04:\n\nBar\u00e7a now 3 points clear at the top.", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgjUGzWwAAVIqJ.jpg"}, {"id": "2114479234957635757", "text": "What changes do Bar\u00e7a need to do in order to get back on track?\n\n___________________________", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgjqLpXcAAKY6U.jpg"}, {"id": "2114479356181361113", "text": "\ud83d\udea8\ud83c\udf99\ufe0f| Pedri: \"We lacked rhythm with the ball. We've had a lot of silly losses. We knew about the danger. We wanted to win El Cl\u00e1sico in front of our fans. We're leaving sad, but this is a very long road.\" #fcblive", "media_type": null, "media_url": null}]