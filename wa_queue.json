[{"id": "2111498115953901946", "text": "\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35", "media_type": null, "media_url": null}, {"id": "2111498423102833010", "text": "\ud83c\udfa5 | WHAT A GOAL BY LAMINE YAMAL. ONE OF THE BEST GOALS OF HIS CAREER. INEXPLICABLE! \u2b50\u2b50\u2b50", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111497835396935680/vid/avc1/1280x720/Bt9cozqquTCNCq0v.mp4?tag=14"}, {"id": "2111498815555408043", "text": "HANSI FLICK'S REACTION TO LAMINE YAMAL'S GOAL. \ud83d\ude0d", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111498212741705728/vid/avc1/1280x720/N9b1BgKuAzdv46k8.mp4?tag=14"}, {"id": "2111499656228155521", "text": "15' Adeyemi with a BIG chance. Was probably millimeters offside.", "media_type": null, "media_url": null}, {"id": "2111499849535226224", "text": "A piece of art. \ud83c\udfa8", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111498698475687936/vid/avc1/1284x720/-n-a91g__Y0ymyb8.mp4?tag=14"}, {"id": "2111501965037387855", "text": "\ud835\udc00\ud835\udc2e\ud835\udc2b\ud835\udc1a.", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU2P2FHXMAAHX__.jpg"}, {"id": "2111502305820356634", "text": "26' Goal Real Betis. 1-1 \ud83d\udfe2", "media_type": null, "media_url": null}, {"id": "2111502596296822798", "text": "Real Betis 1-1. Xavi Espart beaten in the air.", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111502155068612608/vid/avc1/1280x720/Scuqspqvi_zilxEf.mp4?tag=14"}, {"id": "2111504180078579986", "text": "33' BIG CHANCE FOR ADEYEMI AFTER A MAGNIFICENT PASS FROM LAMINE BUT HE'S UNABLE TO SCORE. He was again onside!", "media_type": null, "media_url": null}, {"id": "2111504800105869379", "text": "What a pass from LAMINE to Adyeemi. \ud83e\udd2f", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111504194624454656/vid/avc1/1280x536/m1FG3lp1K8XRYm9p.mp4?tag=14"}, {"id": "2111505139546689813", "text": "\ud83d\udea8 Karim Adeyemi's wife Loredana on IG, reacting to Lamine' golazo: \u201cWAAAUWWWW\u201d", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111504350505779201/vid/avc1/590x1280/BOBZBeTeeM41_cAp.mp4?tag=29"}, {"id": "2111505383080530331", "text": "\ud835\udc08\ud835\udc0d\ud835\udc02\ud835\udc11\ud835\udc04\ud835\udc03\ud835\udc08\ud835\udc01\ud835\udc0b\ud835\udc04 \ud835\udc0b\ud835\udc00\ud835\udc0c\ud835\udc08\ud835\udc0d\ud835\udc04 \ud835\udc18\ud835\udc00\ud835\udc0c\ud835\udc00\ud835\udc0b. The run \u26a1", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2111504894402154496/pu/vid/avc1/1280x720/ebq0xJNkD4ANnXy4.mp4?tag=12"}, {"id": "2111505518082629671", "text": "39' BIG SAVE FROM JOAN GARCIA TO DENY BELLERIN. \ud83d\udc4f", "media_type": null, "media_url": null}, {"id": "2111505863198290031", "text": "GOALLLLLLLLLL RODRI. HE SCORES HIS FIRST GOAL FOR BARCELONA. 2-1 BAR\u00c7AAAAAA \ud83d\udc9c\ud83d\udda4", "media_type": null, "media_url": null}, {"id": "2111506311011594670", "text": "\ud83c\udfa5 | RODRI GUIDES THE BALL INTO BACK OF THE NET FROM THE CORNER. FIRST GOAL AS A BARCA PLAYER. #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111505856193802240/vid/avc1/1284x720/9gahSUgfONfF8SWf.mp4?tag=14"}, {"id": "2111506447552880717", "text": "42' Goal Real Betis. 2-2. Insane golazo by Lo Celso. \ud83d\udfe2", "media_type": null, "media_url": null}, {"id": "2111506701450879475", "text": "Sometimes all you have to do is sit back and accept it.", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111506176672239616/vid/avc1/1280x720/k0E1M-MTshi3XnEf.mp4?tag=14"}, {"id": "2111507210882679028", "text": "45' REAL BETIS' GOAL RULED OUT. DELIBERATE HANDBALL TO CONTROL THE BALL BY CUCHO HERNANDEZ. \ud83d\udd34\u274c", "media_type": null, "media_url": null}, {"id": "2111508914663518291", "text": "Half-time: Real Betis \ud835\udfcf-\ud835\udfd0 Barcelona\n\nThoughts on the game so far? #fcblive \ud83e\udd14", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU2WKxBWEAEwbwP.jpg"}, {"id": "2111509365265924140", "text": "\ud835\udc16\ud835\udc07\ud835\udc00\ud835\udc13 \ud835\udc00 \ud835\udc12\ud835\udc08\ud835\udc06\ud835\udc0d\ud835\udc08\ud835\udc0d\ud835\udc06. \ud83d\udc8e", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU2WlAcWAAAdeYu.jpg"}, {"id": "2111511789770862789", "text": "Some people are gonna cry about this blatant handball too. \ud83d\ude39", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111507945888395264/vid/avc1/632x544/GXz_FbzEbi57z_lv.mp4?tag=14"}, {"id": "2111511911837691951", "text": "\ud835\udc01\ud835\udc04\ud835\udc12\ud835\udc13 \ud835\udc08\ud835\udc0d \ud835\udc13\ud835\udc07\ud835\udc04 \ud835\udc16\ud835\udc0e\ud835\udc11\ud835\udc0b\ud835\udc03. \ud83d\udc51", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU2Y5G7X0AAVmsd.jpg"}, {"id": "2111512737868087561", "text": "\ud83d\udea8| \ud835\udc11\ud835\udc08\ud835\udc15\ud835\udc00\ud835\udc0b \ud835\udc16\ud835\udc00\ud835\udc13\ud835\udc02\ud835\udc07: Nuno Mendes was forced off in the 86th minute due to injury against Strasbourg, just three days before Bar\u00e7a play against PSG. The extent of the injury will be evaluated soon. [@AndiOnrubia] #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU2ZpUuWMAASq8X.jpg"}, {"id": "2111512941602214352", "text": "45' The second half. \ud83d\udfe3\u26ab", "media_type": null, "media_url": null}, {"id": "2111513250282037592", "text": "\ud83d\udea8 Eric replaces Gerard Mart\u00edn at HT, who has suffered a knock. #fcblive", "media_type": null, "media_url": null}, {"id": "2111513484911415487", "text": "46' Jesus inches away from making it 3-1. Great cross by Adeyemi.", "media_type": null, "media_url": null}, {"id": "2111514005336383665", "text": "\ud83d\udea8 Raphinha and Olmo warming up. #fcblive \ud83d\udd25", "media_type": null, "media_url": null}, {"id": "2111514232730583221", "text": "48' FERM\u00cdN ALMOST! He decides to go for goal himself but Valles with a clever save.", "media_type": null, "media_url": null}, {"id": "2111514632623980601", "text": "50' Gabriel Jesus scores but it's OFFSIDE!", "media_type": null, "media_url": null}, {"id": "2111515046601761100", "text": "\ud83c\udfa5 | GABRIEL JESUS CONTINUES HIS UNSTOPPABLE FORM WITH ANOTHER GOAL. LAMINE YAMAL ASSIST. #fcblive \ud83d\udfe3\u26ab", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111514651145953280/vid/avc1/1280x720/nPYnxoxlxqdmxjen.mp4?tag=14"}]