[{"id": "2110628077998924286", "text": "\ud83d\udea8 | \ud835\udc0e\ud835\udc05\ud835\udc05\ud835\udc08\ud835\udc02\ud835\udc08\ud835\udc00\ud835\udc0b: Tyler, The Creator x FC Barcelona. #fcblive \ud83d\udc55", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUp1DVOXQAAPeWn.jpg"}, {"id": "2110628919778898016", "text": "LY10 x Tyler, The Creator \ud83c\udf1f", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUp10N4WUAAtVGl.jpg"}, {"id": "2110629848704078307", "text": "Do you like the new Bar\u00e7a \u00d7 Spotify collab shirt for the Cl\u00e1sico?", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUp2qRNW4AAs0n9.jpg"}, {"id": "2110644507553198158", "text": "\ud835\udc00\ud835\udc2e\ud835\udc2b\ud835\udc1a.", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUqD_sHWQAAG9Gx.jpg"}, {"id": "2110650499342995892", "text": "Style meets aura \ud83e\udd76", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUqJcRqWsAAMDeq.jpg"}, {"id": "2110654472460362080", "text": "\ud83d\udea8 | \ud835\udc0e\ud835\udc05\ud835\udc05\ud835\udc08\ud835\udc02\ud835\udc08\ud835\udc00\ud835\udc0b: Lamine has been included in the @Sofascore Champions League Team of the Week. #fcblive \ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUqNDuXWsAAAL0o.jpg"}, {"id": "2110664185159827710", "text": "\ud83d\udea8\ud83c\udf96| \ud835\udc09\ud835\udc14\ud835\udc12\ud835\udc13 \ud835\udc08\ud835\udc0d: Raphinha is set to rejoin Barcelona\u2019s group training today and is hoping to be available against Real Betis. Raphinha has been feeling better, but Flick will have the final say on his availability. [@monfortcarlos] #fcblive \ud83c\udde7\ud83c\uddf7\ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUqV4sZXgAEAm3D.jpg"}, {"id": "2110694573940887907", "text": "\ud83d\udea8\ud83c\udf96| \ud835\udc09\ud835\udc14\ud835\udc12\ud835\udc13 \ud835\udc08\ud835\udc0d: Frenkie could MAKE the squad for the match against Real Betis as he continues TRAINING with the group. [@Nilsola10] #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUqxh7gWAAADdLl.jpg"}, {"id": "2110698236235162094", "text": "They're \ud835\udc01\ud835\udc00\ud835\udc02\ud835\udc0a \ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUq03HOXYAAa9fp.jpg"}, {"id": "2110702582087729302", "text": "POST UCL SESSION \ud83c\udf1f", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUq40EJWcAAtIfe.jpg"}, {"id": "2110710136343806121", "text": "Lamine, Adeyemi, Kound\u00e9, Anthony and Rodri's reaction when they found out who the next artist is \ud83d\ude0d", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2110709845427167232/vid/avc1/720x1280/ggIItatLMXKM0oRm.mp4?tag=29"}, {"id": "2110714436872798482", "text": "Raphinha and Frenkie in training today \ud83e\udd29", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUrDmHdXUAAZbN1.jpg"}, {"id": "2110715928728002928", "text": "Flick and Raphinha today \u2764", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2110707002104012800/vid/avc1/720x900/CzhA77dTyOyjcpoY.mp4?tag=29"}, {"id": "2110748280418165175", "text": "\ud83d\udea8\ud83c\udf96| \ud835\udc01\ud835\udc11\ud835\udc04\ud835\udc00\ud835\udc0a\ud835\udc08\ud835\udc0d\ud835\udc06: Alejandro Balde is considering leaving Barcelona in January due to his lack of playing time after featuring just 12 minutes across 10 matches. [@ferrancorreas] #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HUriX85XwAArsrA.jpg"}]