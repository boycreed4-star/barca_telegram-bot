[{"id": "2125633252832444820", "text": "\ud835\udc00\ud835\udc2b\ud835\udc2b\ud835\udc22\ud835\udc2f\ud835\udc1a\ud835\udc25. \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2125632012002148353/vid/avc1/1080x1920/h27EbiETLmUZ5s_X.mp4?tag=16"}, {"id": "2125639243972170133", "text": "Gavi and Flick \ud83e\udd79\u2764\ufe0f", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2125374049400311808/vid/avc1/804x720/6bdxeu-QsKTFyp13.mp4?tag=29"}, {"id": "2125645565631365389", "text": "The BAKU OLYMPIC STADIUM \ud83c\udde6\ud83c\uddff", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2125645125506220032/vid/avc1/1024x576/BWVy-FWZlNwzQN3e.mp4?tag=29"}, {"id": "2125646707106938990", "text": "A cute LY304 celebration \ud83e\udd79\u2764\ufe0f", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HX_QanrXIAAfH2P.jpg"}, {"id": "2125647083403149620", "text": "1' KICK-OFF. VAMOS BAR\u00c7AAA! \ud83d\udd35", "media_type": null, "media_url": null}, {"id": "2125649681539571748", "text": "10' All quiet so far.", "media_type": null, "media_url": null}, {"id": "2125651129224642634", "text": "15' Anthony Gordon with a good sight of the goal but his shot goes off target.", "media_type": null, "media_url": null}, {"id": "2125652072959783119", "text": "19' Bar\u00e7a now beginning to knock on Sabah's goal.", "media_type": null, "media_url": null}, {"id": "2125652391236132865", "text": "20' Pedri with a ROCKET of a volley but it's pushed away by the Sabah goalie!", "media_type": null, "media_url": null}, {"id": "2125653705387135370", "text": "25' Brilliant defending by Frenkie. Crucial interception to prevent a dangerous shot chance!", "media_type": null, "media_url": null}, {"id": "2125653865404010710", "text": "26' Sabah HIT THE POST!", "media_type": null, "media_url": null}, {"id": "2125654980795289996", "text": "GOALLLLLLLLL ANTHONY GORDON. HE SCORES FROM A REBOUND TO PUT BAR\u00c7A AHEAD. 1-0 BAR\u00c7AAAAAA \ud83d\udd35\ud83d\udd25", "media_type": null, "media_url": null}, {"id": "2125655286882955406", "text": "\ud83c\udfa5 | Anthony Gordon draws the first blood in Azerbaijan. 1-0 to the away side! #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2125654826348351488/vid/avc1/1280x720/im5UIoui05kj7Anr.mp4?tag=14"}, {"id": "2125655411411853731", "text": "32' ANTHONY GORDON SCORES AGAIN BUT IT'S OFFSIDE! \ud83d\udd34\ud83d\udd34\ud83d\udd34", "media_type": null, "media_url": null}, {"id": "2125658508703981620", "text": "45' Anthony Gordon has been sensational in this first half. \ud83d\udc4f", "media_type": null, "media_url": null}, {"id": "2125659021013049511", "text": "\ud83d\udea8 Half-time: Sabah \ud835\udfce-\ud835\udfcf Barcelona\n\nBar\u00e7a go into the break with a narrow lead. Your thoughts? #fcblive #UCL \ud83e\udd14", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HX_bnWpWYAAVoWK.jpg"}, {"id": "2125659786960044412", "text": "Thoughts on Balde's 45 minutes? \ud83e\udd14", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HX_cTzdWsAAanJg.jpg"}, {"id": "2125663504715616408", "text": "45' The second half.\n\n\ud83d\udd34 Pedri\n\ud83d\udfe2 Dani Olmo", "media_type": null, "media_url": null}, {"id": "2125664627878978021", "text": "\ud83c\udfa5 | Anthony Gordon DOUBLES the lead and secures his brace. Brilliant work by Adeyemi and Jesus in the build-up. #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2125664176731234304/vid/avc1/1280x720/N2i95ZhpID79r8LO.mp4?tag=14"}, {"id": "2125665247360872701", "text": "GOALLLLLLLLL KARIM ADEYEMIIIIII. 3-0 BAR\u00c7AAAAAAA \ud83d\udd35\ud83d\udca5", "media_type": null, "media_url": null}, {"id": "2125665419302191238", "text": "B\ud83c\udd70\ufe0fLDE \ud83d\ude09", "media_type": null, "media_url": null}, {"id": "2125665479037538689", "text": "\ud83c\udfa5 | KARIM ADEYEMI SCORES BAR\u00c7A's THIRD. BRILLIANT ASSIST BY ALEJANDRO BALDE. #fcblive \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2125665105769541632/vid/avc1/1280x720/urUW78CxuRaTHUAb.mp4?tag=14"}, {"id": "2125665973092888732", "text": "\ud835\udc16\ud835\udc07\ud835\udc00\ud835\udc13 \ud835\udc00 \ud835\udc05**\ud835\udc02\ud835\udc0a\ud835\udc08\ud835\udc0d \ud835\udc0f\ud835\udc04\ud835\udc11\ud835\udc05\ud835\udc0e\ud835\udc11\ud835\udc0c\ud835\udc00\ud835\udc0d\ud835\udc02\ud835\udc04. \ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HX_h8D4XMAAMQXW.jpg"}, {"id": "2125666581195751502", "text": "GOALLLLLLLL GABRIEL JESUS. HE PUSHES ONE IN FROM THE CORNER. 4-0 BAR\u00c7AAAAA \ud83d\udd35\ud83c\udde7\ud83c\uddf7", "media_type": null, "media_url": null}, {"id": "2125666808715731357", "text": "\ud83c\udfa5 | Gabriel Jesus finally gets his goal. He will be feeling relieved. 4-0 Barcelona. #fcblive \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2125666415583612928/vid/avc1/1280x720/0kbpo85XKiJFThq9.mp4?tag=14"}, {"id": "2125667304226570368", "text": "62' Goal Sabah. They pull one back. 1-4.", "media_type": null, "media_url": null}, {"id": "2125667808843337855", "text": "64' ALEX CAMPOS ON FOR HIS DEBUT. Cancelo comes on too!\n\nFrenkie and Balde off.", "media_type": null, "media_url": null}, {"id": "2125668036367556736", "text": "\ud83c\udfa5 | Sabah's goal. Ferm\u00edn gave away the ball. #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2125667288493830144/vid/avc1/1280x720/IXhrpoWlHWOriz7-.mp4?tag=14"}, {"id": "2125670437749145650", "text": "75' Substitution:\n\n\ud83d\udd34 Gordon\n\ud83d\udfe2 RAPHINHA", "media_type": null, "media_url": null}, {"id": "2125671648430825928", "text": "80' ADEYEMI'S SHOT RATTLES THE CROSSBAR.", "media_type": null, "media_url": null}]