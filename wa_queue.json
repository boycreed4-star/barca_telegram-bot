[{"id": "2111460997789589589", "text": "\u2757| Bisiwu and Hamza will START against Utebo this afternoon, with Belletti deploying both alongside Aziz Issah in an attacking trio. [@scapde_42] #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU1qlqcWsAAhmXS.jpg"}, {"id": "2111462945389473929", "text": "\ud83d\udea8\ud83d\udcf2 | Lamine Yamal on IG:", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU1sXCXWQAA2k7S.jpg"}, {"id": "2111463375272128652", "text": "He's ready \ud83e\udd76", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU1swBvW0AA-dVC.jpg"}, {"id": "2111466648511172972", "text": "Our Maestros have returned \ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU1vualWQAAObDJ.jpg"}, {"id": "2111466785593557353", "text": "\ud83d\udea8 \ud835\udc11\ud835\udc08\ud835\udc15\ud835\udc00\ud835\udc0b \ud835\udc16\ud835\udc00\ud835\udc13\ud835\udc02\ud835\udc07: PSG have rested almost all of their KEY players today against Strasbourg ahead of the match against Bar\u00e7a:\n\n\u2022 Ousmane Demb\u00e9l\u00e9\n\u2022 D\u00e9sir\u00e9 Dou\u00e9\n\u2022 Fabian Ruiz\n\u2022 Vitinha\n\u2022 Nuno Mendes\n\u2022 Willian Pacho\n\u2022 Marquinhos\n\u2022 Achraf Hakimi\n\nAll 'rested'. \u274c", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU1v2kAWsAE_tHN.jpg"}, {"id": "2111470150272590149", "text": "\ud83d\udea8| \ud835\udc0e\ud835\udc05\ud835\udc05\ud835\udc08\ud835\udc02\ud835\udc08\ud835\udc00\ud835\udc0b: Bar\u00e7a Atl\u00e9tic's STARTING XI against Utebo.\n\nHamza Abdelkarim STARTS. #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU1y6bEXMAATwbF.jpg"}, {"id": "2111474560700739782", "text": "\ud83c\udfa5 | GOALLLLLLL. Hamza Abdelkarim scores for Bar\u00e7a Atl\u00e9tic inside 5 mins from the spot. Penalty won by Jesse Bisiwu. [@ArsenKveFCB] #fcblive \ud83c\uddea\ud83c\uddec\ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111474089940410368/vid/avc1/1802x1206/uQ4MMMfdLAk2QIRI.mp4?tag=29"}, {"id": "2111482074280481200", "text": "\ud835\udc01\ud835\udc00\ud835\udc02\ud835\udc0a \ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU19wfuXIAA8ZkN.jpg"}, {"id": "2111483683295101185", "text": "All set for today's clash. Vamos! \ud83d\udc9c", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU1_OG9XsAANjxm.jpg"}, {"id": "2111486517591842984", "text": "\ud83d\udea8\ud83d\udde3\ufe0f @FabrizioRomano: \"More clubs tracking Balde. If he\u2019s not going to play, this could be a situation to watch in January or in next summer. It won't be an easy deal and also not an easy situation to clarify.\" #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU2BzHoWEAArib_.jpg"}, {"id": "2111490484593979585", "text": "\ud835\udc0b\ud835\udc18.", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU2FaBsWQAAsnp8.jpg"}, {"id": "2111495383335444895", "text": "1' Kick-off. Vamos Bar\u00e7a! \ud83d\udc9c\ud83d\udda4", "media_type": null, "media_url": null}, {"id": "2111497358244471275", "text": "6' Bar\u00e7a are beginning to create chances.", "media_type": null, "media_url": null}, {"id": "2111497524913590501", "text": "7' GERARD MART\u00cdN IS DOWN HOLDING HIS LEG. \ud83d\udd34", "media_type": null, "media_url": null}, {"id": "2111498030155182302", "text": "GOALLLLLLLLLLL LAMINE YAMAL. WOW, WOW, WOW. THAT IS UNREALLLLLLL! 1-0 BAR\u00c7AAAAAAAA \ud83d\udc9c", "media_type": null, "media_url": null}, {"id": "2111498115953901946", "text": "\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35\ud83d\ude35", "media_type": null, "media_url": null}, {"id": "2111498423102833010", "text": "\ud83c\udfa5 | WHAT A GOAL BY LAMINE YAMAL. ONE OF THE BEST GOALS OF HIS CAREER. INEXPLICABLE! \u2b50\u2b50\u2b50", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111497835396935680/vid/avc1/1280x720/Bt9cozqquTCNCq0v.mp4?tag=14"}, {"id": "2111498815555408043", "text": "HANSI FLICK'S REACTION TO LAMINE YAMAL'S GOAL. \ud83d\ude0d", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111498212741705728/vid/avc1/1280x720/N9b1BgKuAzdv46k8.mp4?tag=14"}, {"id": "2111499656228155521", "text": "15' Adeyemi with a BIG chance. Was probably millimeters offside.", "media_type": null, "media_url": null}, {"id": "2111499849535226224", "text": "A piece of art. \ud83c\udfa8", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111498698475687936/vid/avc1/1284x720/-n-a91g__Y0ymyb8.mp4?tag=14"}, {"id": "2111501965037387855", "text": "\ud835\udc00\ud835\udc2e\ud835\udc2b\ud835\udc1a.", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HU2P2FHXMAAHX__.jpg"}, {"id": "2111502305820356634", "text": "26' Goal Real Betis. 1-1 \ud83d\udfe2", "media_type": null, "media_url": null}, {"id": "2111502596296822798", "text": "Real Betis 1-1. Xavi Espart beaten in the air.", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111502155068612608/vid/avc1/1280x720/Scuqspqvi_zilxEf.mp4?tag=14"}, {"id": "2111504180078579986", "text": "33' BIG CHANCE FOR ADEYEMI AFTER A MAGNIFICENT PASS FROM LAMINE BUT HE'S UNABLE TO SCORE. He was again onside!", "media_type": null, "media_url": null}, {"id": "2111504800105869379", "text": "What a pass from LAMINE to Adyeemi. \ud83e\udd2f", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111504194624454656/vid/avc1/1280x536/m1FG3lp1K8XRYm9p.mp4?tag=14"}, {"id": "2111505139546689813", "text": "\ud83d\udea8 Karim Adeyemi's wife Loredana on IG, reacting to Lamine' golazo: \u201cWAAAUWWWW\u201d", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111504350505779201/vid/avc1/590x1280/BOBZBeTeeM41_cAp.mp4?tag=29"}, {"id": "2111505383080530331", "text": "\ud835\udc08\ud835\udc0d\ud835\udc02\ud835\udc11\ud835\udc04\ud835\udc03\ud835\udc08\ud835\udc01\ud835\udc0b\ud835\udc04 \ud835\udc0b\ud835\udc00\ud835\udc0c\ud835\udc08\ud835\udc0d\ud835\udc04 \ud835\udc18\ud835\udc00\ud835\udc0c\ud835\udc00\ud835\udc0b. The run \u26a1", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2111504894402154496/pu/vid/avc1/1280x720/ebq0xJNkD4ANnXy4.mp4?tag=12"}, {"id": "2111505518082629671", "text": "39' BIG SAVE FROM JOAN GARCIA TO DENY BELLERIN. \ud83d\udc4f", "media_type": null, "media_url": null}, {"id": "2111505863198290031", "text": "GOALLLLLLLLLL RODRI. HE SCORES HIS FIRST GOAL FOR BARCELONA. 2-1 BAR\u00c7AAAAAA \ud83d\udc9c\ud83d\udda4", "media_type": null, "media_url": null}, {"id": "2111506311011594670", "text": "\ud83c\udfa5 | RODRI GUIDES THE BALL INTO BACK OF THE NET FROM THE CORNER. FIRST GOAL AS A BARCA PLAYER. #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2111505856193802240/vid/avc1/1284x720/9gahSUgfONfF8SWf.mp4?tag=14"}]