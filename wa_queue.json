[{"id": "2114330405000081627", "text": "Real Madrid have arrived \u2705", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114325783669780480/vid/avc1/1080x1920/-b6DYlQ3gU6EqqCc.mp4?tag=29"}, {"id": "2114331631347499477", "text": "\ud83d\udea8| \ud835\udc0e\ud835\udc05\ud835\udc05\ud835\udc08\ud835\udc02\ud835\udc08\ud835\udc00\ud835\udc0b: Barcelona's squad for the game against Real Madrid. #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVedafTW0AA3e10.jpg"}, {"id": "2114348249796812990", "text": "\ud83d\udea8 Just few hours left until the biggest club game on the planet, and we can't wait. Lamine Yamal will be facing Real Madrid for the first time at Spotify Camp Nou.\n\nBar\u00e7a are favorites to WIN the game with a 62% chance, per Polymarket. \ud83d\udd25\n\nDrop your score predictions below \u2b07", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVesMI6asAAfNU8.jpg"}, {"id": "2114358753503912239", "text": "\ud83c\udfa5 | Bar\u00e7a players arriving at the team hotel ahead of El Clasico. #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114337055274627072/vid/avc1/1080x1920/44vSRKWHdqqWqrBX.mp4?tag=29"}, {"id": "2114374164924494017", "text": "\ud83d\udea8\ud83c\udf96| \ud835\udc09\ud835\udc14\ud835\udc12\ud835\udc13 \ud835\udc08\ud835\udc0d: Thibaut Courtois has been ruled OUT of El Cl\u00e1sico due to a virus. His entourage has confirmed his absence.[@martinezferran, @GerardRomero] #fcblive \u274c", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVfEGJJWMAAEfe_.jpg"}, {"id": "2114391486561157258", "text": "\u2757| \ud835\udc0b\ud835\udc0e\ud835\udc00\ud835\udc0d \ud835\udc16\ud835\udc00\ud835\udc13\ud835\udc02\ud835\udc07: Ronald Ara\u00fajo vs Brighton \u2014\n\n* 8.0 rating\n* 56% pass accuracy (15/27) \ud83c\udfaf\n* 56% pass accuracy in own half (5/9)\n* 56% pass accuracy in opposition half (10/18) \n* 8 clearances \ud83d\udeab\n* 3/2 Tackles won\n* 6 recoveries \ud83d\udd04\n* Won 4/4 ground duels \u2708\ufe0f\n* 0 fouls committed \u2705\n\n#fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVfT2kQXQAAiASv.jpg"}, {"id": "2114401678233305445", "text": "3 hours to go.\n\nThe Spotify Camp Nou is ready. \ud83c\udfdf", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVfdHxOXcAAw9Ea.jpg"}, {"id": "2114406615453491204", "text": "Ready \ud83d\udc99\u2764\ufe0f", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVfhnJKW8AAmv4q.jpg"}, {"id": "2114407050943844641", "text": "Atmosphere is building up in the streets \ud83d\udd25\ud83d\udd35\ud83d\udd34", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114386162324283393/vid/avc1/576x1024/xPtriSstYXxHppI-.mp4?tag=29"}, {"id": "2114409705824977064", "text": "\ud83d\udea8\ud83c\udf96| \ud835\udc09\ud835\udc14\ud835\udc12\ud835\udc13 \ud835\udc08\ud835\udc0d: Barcelona are MONITORING 18-year-old American winger Gabriel Wesseh, who currently plays for Norwegian club Fredrikstad FK. [@Jordigil] #fcblive \ud83d\udc40", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVfkbCsWQAA0iwm.jpg"}, {"id": "2114411311215813112", "text": "BAR\u00c7A IS READY \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114406093422043136/vid/avc1/720x1280/ds9gyjUDTDb-AjV1.mp4?tag=29"}, {"id": "2114411867397410953", "text": "Dressing room. \ud83d\udc55", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114406795317829632/vid/avc1/1080x1920/x1fIVFkBkwmaE_QV.mp4?tag=16"}, {"id": "2114414642768253438", "text": "\ud835\udc14\ud835\udc0d\ud835\udc11\ud835\udc04\ud835\udc00\ud835\udc0b \ud835\udc00\ud835\udc13\ud835\udc0c\ud835\udc0e\ud835\udc12\ud835\udc0f\ud835\udc07\ud835\udc04\ud835\udc11\ud835\udc04 \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114413945670795266/vid/avc1/576x1024/4pjhlkCIKSwianpC.mp4?tag=29"}, {"id": "2114415903865466933", "text": "\ud83d\udea8 RMTV, right now: \u201cEverything suggests that it won't be a normal match. What hopes we can have? The on-field referee has filed a complaint against us in the past, while the VAR ref was involved in Carlos Romercs violent tackle on Mbappe. Real Madrid fans have no hopes from the referees. We and Bar\u00e7a are polar opposite in benefitting from refereeing decisions.\u201d \u26aa", "media_type": null, "media_url": null}, {"id": "2114416855897055308", "text": "\ud835\udc01\ud835\udc00\ud835\udc11\ud835\udc02\ud835\udc00 \ud835\udc14\ud835\udc0b\ud835\udc13\ud835\udc11\ud835\udc00\ud835\udc12 \ud83d\udd25\ud83d\udd0a", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114415503514992640/vid/avc1/1920x1080/mvhxCv_qNUwVSDWj.mp4?tag=29"}, {"id": "2114420061809070160", "text": "BAR\u00c7A, BAR\u00c7AA, BAR\u00c7AAA \ud83d\udc99\u2764", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114419335171047424/vid/avc1/576x1024/ijGYfZwUxJY6xYfH.mp4?tag=29"}, {"id": "2114424472715309264", "text": "Lamine Yamal has arrived.", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2114423236200906752/pu/vid/avc1/1280x720/Ujl2-45GHWwLOmA2.mp4?tag=12"}, {"id": "2114425624358011269", "text": "Ferm\u00edn & Raphinha \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2114423698111291393/pu/vid/avc1/1280x720/Tr-hcBd6kb5FZziw.mp4?tag=12"}, {"id": "2114427149377519983", "text": "\ud83d\udea8 Real Madrid STARTING XI. @MadridXtra", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVf0SZbXwAArcLn.jpg"}, {"id": "2114430033913589765", "text": "\ud83c\udf7f\ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVf26L2W8AAmBld.jpg"}, {"id": "2114431975469584739", "text": "\ud83c\udfa5 | Bar\u00e7a and Real Madrid's bus arrivals. #fcblive", "media_type": "vid