[{"id": "2119439542264451508", "text": "\ud83d\udea8\ud83c\udf99\ufe0f| Joan Laporta: \"Raphinha is the best in the world in his position. He doesn't just play as a 9 he plays in various attacking positions and covers the whole pitch.\" #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWnDCFjX0AA3Flw.jpg"}, {"id": "2119451063388459353", "text": "Happy Diwali to all those celebrating from Team BarcaTimes! \ud83e\ude94\ud83d\udd35\ud83d\udd34\n\nMay your life be filled with vibrant colors, endless joy, and triumph. Wishing all Cules a beautiful, safe, and blessed Festival of Lights. \u2764", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWnNgtKWAAAKFdl.jpg"}, {"id": "2119458967529132308", "text": "Roony \u23f3", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2119373475010027520/vid/avc1/720x1280/FvDgiI71RZLV_ISu.mp4?tag=29"}, {"id": "2119463228015018073", "text": "\u2757| \ud835\udc0b\ud835\udc0e\ud835\udc00\ud835\udc0d \ud835\udc16\ud835\udc00\ud835\udc13\ud835\udc02\ud835\udc07: Ronald Ara\u00fajo \ud83c\udd9a Crystal Palace:\n\n\u2022 7.6 rating\n\u2022 66% pass accuracy (23/35) \ud83c\udfaf\n\u2022 83% pass accuracy in own half (15/18)\n\u2022 47% pass accuracy in opposition half\n\u2022 5 clearances \ud83d\udeab\n\u2022 2/4 aerial duels Won\n\u2022 2 recoveries \ud83d\udd04\n\u2022 Won 2/6 ground duels \n\u2022 9 Def.contributions \u2705\n\n\ud835\udc16\ud835\udc07\ud835\udc00\ud835\udc13 \ud835\udc00 \ud835\udc06\ud835\udc00\ud835\udc0c\ud835\udc04! \ud83e\udd2f\ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWnYkvjXAAAyJNS.jpg"}, {"id": "2119494777729118373", "text": "Captain \u2764", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWn1RMkXoAA2UWC.jpg"}, {"id": "2119499376783511690", "text": "The venue for tonight \ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWn5c5jXYAAngyj.jpg"}, {"id": "2119500300469871059", "text": "We're here \ud83d\udd25\ud83d\udd35", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2119499830712020992/vid/avc1/1080x1920/Xou4yrU5_hz4v_Or.mp4?tag=16"}, {"id": "2119500790670774587", "text": "\ud83d\udea8| \ud835\udc01\ud835\udc11\ud835\udc04\ud835\udc00\ud835\udc0a\ud835\udc08\ud835\udc0d\ud835\udc06: Marc Bernal STARTS. #fcblive", "media_type": null, "media_url": null}, {"id": "2119501806912884768", "text": "\ud83d\udea8| \ud835\udc0e\ud835\udc05\ud835\udc05\ud835\udc08\ud835\udc02\ud835\udc08\ud835\udc00\ud835\udc0b: Barcelona's STARTING XI against Atl\u00e9tico Madrid. #fcblive \ud83d\udd35", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWn7qXBWkAAb5sB.jpg"}, {"id": "2119507170525884736", "text": "TITULAR \ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWoAibIWwAA1lQX.jpg"}, {"id": "2119507787097002225", "text": "\ud83d\udc4b", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWoBGcDXwAA7QtJ.jpg"}, {"id": "2119513978548228139", "text": "Joan Garc\u00eda", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWoGuqKX0AE6Mlb.jpg"}, {"id": "2119515684984041491", "text": "\ud83c\udfa5 Players are out for the warm up", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2119512902155616256/vid/avc1/1080x1920/NGjf9nkdAlqV8Ojp.mp4?tag=16"}, {"id": "2119516314746212752", "text": "Lamine is Ready \ud83c\udf1f", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWoI2qsWIAAiXDq.jpg"}, {"id": "2119516657492042115", "text": "Pedri Magic  \ud83e\ude84 \u23f3\ufe0f", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWoJKl5WgAA90SP.jpg"}, {"id": "2119517406292840496", "text": "\ud83d\udea8\ud83c\udf99\ufe0f| Hansi Flick: \"Bernal has been doing a good job this season, which is why he's starting. Fari\u00f1as is in good form and has a good understanding with Lamine. Eric isn't up to more than 30 minutes today.\" #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWoJ2YgWIAAaReR.jpg"}, {"id": "2119517570495570075", "text": "\ud83d\udea8\ud83c\udf99\ufe0f| Simeone: \"We know Bar\u00e7a press very well. It's an important, exciting match to show what the team is capable Of.\" #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWoJ_7yXAAA7ozq.jpg"}, {"id": "2119520730454925538", "text": "1' KICK-OFF. \ud83d\udd35", "media_type": null, "media_url": null}, {"id": "2119521867019026666", "text": "4' Poor start from Bar\u00e7a so far.", "media_type": null, "media_url": null}, {"id": "2119522232082849864", "text": "5' JULIAN ALVAREZ MISSES A 1v1. Bar\u00e7a are saved!", "media_type": null, "media_url": null}, {"id": "2119522344905445727", "text": "5' PUBILL HITS THE POST. BAR\u00c7A ARE SLEEPING!", "media_type": null, "media_url": null}, {"id": "2119522661642518918", "text": "7' PEDRI RATTLES THE CROSSBAR. SO CLOSE!", "media_type": null, "media_url": null}, {"id": "2119522874407240188", "text": "Alvarez CLOSE \ud83d\ude2c", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2119522625127174144/vid/avc1/1280x720/rpFNLLF75Njh4m5m.mp4?tag=29"}, {"id": "2119523193555730843", "text": "9' Goal Atl\u00e9tico Madrid. Guiliano Simeone. 1-0. \ud83d\udd34", "media_type": null, "media_url": null}, {"id": "2119524009905913972", "text": "Simeone's OPENER. Alvarez ASSIST. \u26bd", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2119523082624811008/vid/avc1/1280x720/z4M5Pw_2Mv_mEhMR.mp4?tag=14"}, {"id": "2119525036969107745", "text": "16' Brilliant dribble and cross by Lamine to Ferm\u00edn but his shot is blocked.", "media_type": null, "media_url": null}, {"id": "2119526109985276332", "text": "20' Atl\u00e9tico close to scoring their second.", "media_type": null, "media_url": null}, {"id": "2119526676170166582", "text": "Lamine is cooking Grimaldo so far.", "media_type": null, "media_url": null}, {"id": "2119527133059878997", "text": "Joan Garcia and Joao Cancelo after Atl\u00e9tico's goal \ud83d\udc40", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWoSseeXsAA6-kT.jpg"}, {"id": "2119527485368934518", "text": "26' Julian Alvarez inches close from making it two, stopped by Joan Garcia. Cancelo gave the ball away.", "media_type": null, "media_url": null}]