[{"id": "2114407050943844641", "text": "Atmosphere is building up in the streets \ud83d\udd25\ud83d\udd35\ud83d\udd34", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114386162324283393/vid/avc1/576x1024/xPtriSstYXxHppI-.mp4?tag=29"}, {"id": "2114409705824977064", "text": "\ud83d\udea8\ud83c\udf96| \ud835\udc09\ud835\udc14\ud835\udc12\ud835\udc13 \ud835\udc08\ud835\udc0d: Barcelona are MONITORING 18-year-old American winger Gabriel Wesseh, who currently plays for Norwegian club Fredrikstad FK. [@Jordigil] #fcblive \ud83d\udc40", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVfkbCsWQAA0iwm.jpg"}, {"id": "2114411311215813112", "text": "BAR\u00c7A IS READY \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114406093422043136/vid/avc1/720x1280/ds9gyjUDTDb-AjV1.mp4?tag=29"}, {"id": "2114411867397410953", "text": "Dressing room. \ud83d\udc55", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114406795317829632/vid/avc1/1080x1920/x1fIVFkBkwmaE_QV.mp4?tag=16"}, {"id": "2114414642768253438", "text": "\ud835\udc14\ud835\udc0d\ud835\udc11\ud835\udc04\ud835\udc00\ud835\udc0b \ud835\udc00\ud835\udc13\ud835\udc0c\ud835\udc0e\ud835\udc12\ud835\udc0f\ud835\udc07\ud835\udc04\ud835\udc11\ud835\udc04 \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114413945670795266/vid/avc1/576x1024/4pjhlkCIKSwianpC.mp4?tag=29"}, {"id": "2114415903865466933", "text": "\ud83d\udea8 RMTV, right now: \u201cEverything suggests that it won't be a normal match. What hopes we can have? The on-field referee has filed a complaint against us in the past, while the VAR ref was involved in Carlos Romercs violent tackle on Mbappe. Real Madrid fans have no hopes from the referees. We and Bar\u00e7a are polar opposite in benefitting from refereeing decisions.\u201d \u26aa", "media_type": null, "media_url": null}, {"id": "2114416855897055308", "text": "\ud835\udc01\ud835\udc00\ud835\udc11\ud835\udc02\ud835\udc00 \ud835\udc14\ud835\udc0b\ud835\udc13\ud835\udc11\ud835\udc00\ud835\udc12 \ud83d\udd25\ud83d\udd0a", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114415503514992640/vid/avc1/1920x1080/mvhxCv_qNUwVSDWj.mp4?tag=29"}, {"id": "2114420061809070160", "text": "BAR\u00c7A, BAR\u00c7AA, BAR\u00c7AAA \ud83d\udc99\u2764", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114419335171047424/vid/avc1/576x1024/ijGYfZwUxJY6xYfH.mp4?tag=29"}, {"id": "2114424472715309264", "text": "Lamine Yamal has arrived.", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2114423236200906752/pu/vid/avc1/1280x720/Ujl2-45GHWwLOmA2.mp4?tag=12"}, {"id": "2114425624358011269", "text": "Ferm\u00edn & Raphinha \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2114423698111291393/pu/vid/avc1/1280x720/Tr-hcBd6kb5FZziw.mp4?tag=12"}, {"id": "2114427149377519983", "text": "\ud83d\udea8 Real Madrid STARTING XI. @MadridXtra", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVf0SZbXwAArcLn.jpg"}, {"id": "2114430033913589765", "text": "\ud83c\udf7f\ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVf26L2W8AAmBld.jpg"}, {"id": "2114431975469584739", "text": "\ud83c\udfa5 | Bar\u00e7a and Real Madrid's bus arrivals. #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2114431350941835264/pu/vid/avc1/720x1280/du7aUOJQCJ3gbEDb.mp4?tag=12"}, {"id": "2114433209379266981", "text": "\ud835\udc00\ud835\udc06 is here \ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVf5zJNXUAA-UqO.jpg"}, {"id": "2114436986547077618", "text": "UNREAL ATMOSPHERE OUTSIDE THE STADIUM. \ud83d\ude80", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114436355719651328/vid/avc1/1080x1920/y97054r4o-YujdmM.mp4?tag=29"}, {"id": "2114443032288244044", "text": "Aitana is one of US \ud83d\udc99\u2764\ufe0f\ud83d\ude0d", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgCu7FW4AAdy5S.jpg"}, {"id": "2114444381469983099", "text": "Tyler, The Creator IS HERE \ud83d\ude0d", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114443163980972033/vid/avc1/720x1280/McK9OZABCnh6T9SX.mp4?tag=16"}, {"id": "2114445306553110961", "text": "Nice to see you Roony \u2764\ufe0f", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2114435735826702336/vid/avc1/1080x1920/29xOaQqtFQ4zypRX.mp4?tag=16"}, {"id": "2114447332091572579", "text": "The Spotify Camp Nou looks ABSOLUTELY STUNNING.", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HVgGpL8XkAAXoyC.jpg"}, {"id": "2114447595158356052", "text": "1' KICK-OFF EL CLASICO.", "media_type": null, "media_url": null}, {"id": "2114448487970488335", "text": "3' Huijsen's mistake gives Lamine an opening but his pass doesn't find Rapha.", "media_type": null, "media_url": null}, {"id": "2114449377846608000", "text": "6' Anthony Gordon's shot on target is saved by Lunin.", "media_type": null, "media_url": null}, {"id": "2114449909034172893", "text": "Lamine toying with Cucurella. \ud83d\ude02", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2114449457538338816/pu/vid/avc1/1280x720/1w1EZvTk1wtc3PIl.mp4?tag=12"}, {"id": "2114451021246206266", "text": "13' YELLOW CARD FORGIVEN FOR CUCURELLA. UNREAL!", "media_type": null, "media_url": null}, {"id": "2114451427938521321", "text": "14' Another shot taken by Gordon. He's getting into the game.", "media_type": null, "media_url": null}, {"id": "2114452189095563729", "text": "17' Brilliant defending by Xavi Espart to deny Mbappe.", "media_type": null, "media_url": null}, {"id": "2114453180155097241", "text": "21' Brilliant run by Pedri into the box and the ball drops perfectly for Raphinha, whose effort goes over.", "media_type": null, "media_url": null}, {"id": "2114453653012582558", "text": "23' BRILLIANT PLAY BY BAR\u00c7A BUT RAPHINHA'S SHOT IS JUST WIDE.", "media_type": null, "media_url": null}, {"id": "2114453748219064401", "text": "Ferm\u00edn skillmaster \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/ext_tw_video/2114452950336552960/pu/vid/avc1/1280x720/1epB70qXTrODCSnb.mp4?tag=12"}, {"id": "2114454486496280938", "text": "STOP THAT LAMINE \ud83d\udd25", "media_type": null, "media_url": null}]