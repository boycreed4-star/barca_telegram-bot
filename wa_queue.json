[{"id": "2117676989532299624", "text": "Counting down to kick-off \u23f3", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWN___cXQAAHIeG.jpg"}, {"id": "2117684469943394343", "text": "\ud83d\udea8 Best player in the world right now, excluding Messi?\n\nMac Allister: \u201cLamine Yamal\u201d. #fcblive", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOGzbHXEAQYKV-.jpg"}, {"id": "2117688148419346836", "text": "\ud835\udc00\ud835\udc2b\ud835\udc2b\ud835\udc22\ud835\udc2f\ud835\udc1a\ud835\udc25 \ud83d\udccd", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2117687909453029376/vid/avc1/720x1280/vjGNo3329QMTs3QX.mp4?tag=29"}, {"id": "2117692794617606398", "text": "Thoughts on Frenkie starting from bench?", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOOX7tWYAE9ipo.jpg"}, {"id": "2117694810945441875", "text": "\ud835\udc00.\ud835\udc06.\ud83d\udd25", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOQNTZWUAAz-YQ.jpg"}, {"id": "2117695166215548940", "text": "UEFA have confirmed that the competition anthem will not be played before kickoff as a mark of respect following the passing of Jes\u00fas de Miguel and in memory of the victims of the Urda train accident. \ud83d\udda4\ud83d\udd4a\ufe0f", "media_type": null, "media_url": null}, {"id": "2117710330167980450", "text": "4' First chance of the night falls for Gordon but his shot is blocked.", "media_type": null, "media_url": null}, {"id": "2117710602768445576", "text": "5' Lamine is fouled on the edge of the box.", "media_type": null, "media_url": null}, {"id": "2117711012094734593", "text": "GOALLLLLLLLLLL LAMINE YAMALLLLLL. 1-0 BAR\u00c7AAAAAAAAAA \ud83d\udd35\ud83d\udd34\ud83d\udd25", "media_type": null, "media_url": null}, {"id": "2117711317331034608", "text": "\ud83c\udfa5 | LAMINE YAMAL OPENS THE SCORING FOR BARCELONA. ASTON VILLA PUNISHED HEAVILY FOR THEIR ERROR. #fcblive", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2117710752840642560/vid/avc1/1280x720/6TMZYJzs8UWfr7w5.mp4?tag=14"}, {"id": "2117711548898488499", "text": "9' Big block from Joao Cancelo. \ud83d\udc4f", "media_type": null, "media_url": null}, {"id": "2117711911441604795", "text": "10' Yellow for Maatsen for a foul on Lamine. \ud83d\udfe1", "media_type": null, "media_url": null}, {"id": "2117712979894362147", "text": "\ud83d\udea8 \ud835\udc11\ud835\udc04\ud835\udc02\ud835\udc0e\ud835\udc11\ud835\udc03: Lamine Yamal is now the highest-scoring teenager in Champions League history, surpassing Kylian Mbapp\u00e9. #fcblive #UCL \u2b50", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOgu5SWgAA_k3W.jpg"}, {"id": "2117713389245841628", "text": "\ud835\udc11\ud835\udc00\ud835\udc08\ud835\udc0d\ud835\udc18 \ud835\udc0d\ud835\udc08\ud835\udc06\ud835\udc07\ud835\udc13 \ud835\udc08\ud835\udc0d \ud835\udc01\ud835\udc00\ud835\udc11\ud835\udc02\ud835\udc04\ud835\udc0b\ud835\udc0e\ud835\udc0d\ud835\udc00.", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOhGtNWMAA49TE.jpg"}, {"id": "2117713921482056073", "text": "18' Cancelo is beaten by Jackson who then crosses the ball into the box, but Manzambi's shot is weak.", "media_type": null, "media_url": null}, {"id": "2117713931091190133", "text": "\ud835\udc00\ud835\udc14\ud835\udc11\ud835\udc00 \ud83e\udd76", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2117713777558982656/vid/avc1/1190x668/N8zFAvYGDwkEJZ4z.mp4?tag=29"}, {"id": "2117714230371655966", "text": "19' WHAT A INTERCEPTION BY JOAN GARCIA. 1v1 vs Jackson and he comes out on top.", "media_type": null, "media_url": null}, {"id": "2117714665568690510", "text": "JOOOAAANNN \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2117713950305390592/vid/avc1/1280x720/XubWhGKwBM8py0Fc.mp4?tag=14"}, {"id": "2117714709579255858", "text": "\ud835\udc07\ud835\udc22\ud835\udc2c \ud835\udc2d\ud835\udc1e\ud835\udc2b\ud835\udc2b\ud835\udc22\ud835\udc2d\ud835\udc28\ud835\udc2b\ud835\udc32. \u2764", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOiThTXAAAJ3KT.jpg"}, {"id": "2117715713213247560", "text": "25' Another defensive error by Aston Villa but Bar\u00e7a this time fail to capitalize. Gordon's shot is saved by Zion.", "media_type": null, "media_url": null}, {"id": "2117716269705167163", "text": "27' SENSATIONAL trivela pass from Lamine to Raphinha but tha latter's first touch is a tad bit heavy.", "media_type": null, "media_url": null}, {"id": "2117716804105555994", "text": "30' Yellow card for Villa's Buendia. \ud83d\udfe1", "media_type": null, "media_url": null}, {"id": "2117717044187537610", "text": "31' JOAN GARCIA DENIES MANZAMBI. WHAT A KEEPER THIS GUY IS!", "media_type": null, "media_url": null}, {"id": "2117720274330137056", "text": "\ud835\udc16\ud835\udc16\ud835\udc04 \ud83d\ude39", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2117718448067252224/vid/avc1/1280x720/HaQMzQeg3bpVwtNL.mp4?tag=29"}, {"id": "2117720422418399478", "text": "44' Raphinha is shown a yellow. Jackson too. \ud83d\udfe1", "media_type": null, "media_url": null}, {"id": "2117720771044728909", "text": "Half-time: Barcelona \ud835\udfcf-\ud835\udfce Aston Villa\n\nWe lead at the break thanks to the strike from Lamine Yamal. What do you make of the game so far? #fcblive #UCL \ud83e\udd14", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOn0aeXEAAa5xf.jpg"}, {"id": "2117724582928896230", "text": "\ud835\udfd5 \ud835\udc06/\ud835\udc00 in 3\u00bd UCL matches this season so far. \n\n\"Big games\" \ud83d\ude39", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOrSSRXIAA0tnG.jpg"}, {"id": "2117724854153519237", "text": "45' SUBSTITUTION:\n\n\ud83d\udd34 Rodri\n\ud83d\udfe2 MARC BERNAL", "media_type": null, "media_url": null}, {"id": "2117725862418133240", "text": "Happy belated Halloween.", "media_type": "photo", "media_url": "https://pbs.twimg.com/media/HWOscyfXwAE8sCB.jpg"}, {"id": "2117727271490318437", "text": "\ud83c\udfa5 | GOALLLLLLL RAPHINHA. RAPHINHA SCORES THE SECOND WITH THE HELP OF A LITTLE DEFLECTION. 2-0! #fcblive \ud83d\udd25", "media_type": "video", "media_url": "https://video.twimg.com/amplify_video/2117726724695773184/vid/avc1/1280x720/tbGSn-PDxDfU-HW4.mp4?tag=14"}]